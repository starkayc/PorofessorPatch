<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme (Apple-inspired) -->
    <SolidColorBrush x:Key="WindowBg" Color="#1C1C1E" />
    <SolidColorBrush x:Key="CardBg" Color="#2C2C2E" />
    <SolidColorBrush x:Key="CardBorder" Color="#3A3A3C" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#98989D" />
    <SolidColorBrush x:Key="ControlBg" Color="#2C2C2E" />
    <SolidColorBrush x:Key="ControlBorder" Color="#3A3A3C" />
    <SolidColorBrush x:Key="IconFg" Color="#F5F5F7" />
    <SolidColorBrush x:Key="IconHover" Color="#3A3A3C" />
    <SolidColorBrush x:Key="IconPressed" Color="#48484A" />
    <SolidColorBrush x:Key="Accent" Color="#30D158" />
    <SolidColorBrush x:Key="AccentHover" Color="#2AC24E" />
    <SolidColorBrush x:Key="AccentPressed" Color="#25B043" />
    <SolidColorBrush x:Key="Danger" Color="#FF453A" />
    <SolidColorBrush x:Key="DangerHover" Color="#3A2322" />
    <SolidColorBrush x:Key="DangerPressed" Color="#4A2B2A" />

</ResourceDictionary>
